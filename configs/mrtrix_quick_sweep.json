    "density_range": [0.02, 0.95],
    "max_isolated_fraction": 0.1
  },
  "sweep_parameters": {
    "cutoff_range": [0.05, 0.1],
    "angle_range": [30, 45],
    "tract_count_range": [500000, 2000000],
    "sampling": {"method": "grid"}
  }

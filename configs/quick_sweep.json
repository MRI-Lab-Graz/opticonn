{
  "description": "Quick sweep configuration for testing OptiConn workflow",
  "comment": "Minimal parameter grid for fast testing and learning",
  
  "dsi_studio_cmd": "/Applications/dsi_studio.app/Contents/MacOS/dsi_studio",
  
  "atlases": [
    "FreeSurferDKT_Cortical"
  ],
  "connectivity_values": [
    "count",
    "fa"
  ],
  
  "tract_count": 100000,
  "thread_count": 4,
  
  "tracking_parameters": {
    "method": 0,
    "otsu_threshold": 0.5,
    "fa_threshold": 0.1,
    "turning_angle": 0.0,
    "step_size": 0.0,
    "smoothing": 0.0,
    "min_length": 10,
    "max_length": 200,
    "track_voxel_ratio": 3.0,
    "check_ending": 0,
    "random_seed": 0,
    "dt_threshold": 0.1
  },
  
  "connectivity_options": {
    "connectivity_type": "pass",
    "connectivity_threshold": 0.001,
    "connectivity_output": "matrix,measure"
  },

  "reliability": {
    "comment": "repeats = tracking runs per subject with different random seeds. Gates reject implausible graphs; tune them to your data.",
    "repeats": 2,
    "density_range": [0.02, 0.6],
    "max_isolated_fraction": 0.1
  },

  "sweep_parameters": {
    "description": "Minimal parameter sweep for quick testing",
    "comment": "Small grid for learning the OptiConn workflow",

    "fa_threshold_range": [0.05, 0.2],
    "min_length_range": [10, 30],
    "track_voxel_ratio_range": [2.0],
    "connectivity_threshold_range": [0.001],
    "tract_count_range": [100000, 500000],
    
    "sampling": {
      "method": "grid",
      "n_samples": 16,
      "random_seed": 42
    }
  }
}